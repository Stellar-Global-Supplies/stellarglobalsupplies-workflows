-- ── 4. approval_queue — ensure workflow_run_id column exists ─────────────────
-- The Python code uses workflow_run_id in approval_queue.
-- Adding it if not present (some older schemas may not have it).

alter table approval_queue
  add column if not exists workflow_run_id uuid references workflow_runs(id) on delete set null;

create index if not exists idx_approval_queue_run
  on approval_queue (workflow_run_id)
  where workflow_run_id is not null;